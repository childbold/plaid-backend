{
  "name": "plaid-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "create-client": "node --env-file=.env scripts/create-client.js",
    "sandbox-item": "node --env-file=.env scripts/sandbox-item.js",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0",
    "jose": "^6.0.0",
    "plaid": "^47.0.0"
  }
}
