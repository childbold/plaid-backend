# Required
PLAID_CLIENT_ID=
PLAID_SECRET=
# npm run gen-key
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32 (at least 24 characters)
ADMIN_API_KEY=

# Optional (defaults shown)
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
# Also pulled when the bank supports them. Each is billed per Item in production; trim to taste.
PLAID_EXTRA_PRODUCTS=liabilities,investments,identity,recurring
PLAID_COUNTRY_CODES=US
PORT=8080
DB_PATH=./data/plaid.db
SYNC_INTERVAL_MINUTES=60
# Comma-separated origins of browser frontends
CORS_ORIGINS=
# Public HTTPS URL ending in /webhooks/plaid
PLAID_WEBHOOK_URL=
# Needed for OAuth banks in production
PLAID_REDIRECT_URI=
