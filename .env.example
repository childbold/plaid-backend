# Required
PLAID_CLIENT_ID=
PLAID_SECRET=
# npm run gen-key
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32 (at least 24 characters)
ADMIN_API_KEY=

# Optional
# sandbox = fake test banks, production = real accounts (use the matching secret)
PLAID_ENV=production
PLAID_PRODUCTS=transactions
# Also pulled when the bank supports them. Each is billed per Item in production, and
# free/Limited Production access may only include some. Leave empty to pull transactions only.
PLAID_EXTRA_PRODUCTS=
PLAID_COUNTRY_CODES=US
PORT=8080
DB_PATH=./data/plaid.db
SYNC_INTERVAL_MINUTES=60
# Comma-separated origins of browser frontends
CORS_ORIGINS=
# Public HTTPS URL ending in /webhooks/plaid
PLAID_WEBHOOK_URL=
# Needed for OAuth banks in production
PLAID_REDIRECT_URI=
