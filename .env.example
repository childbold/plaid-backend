# Required
PLAID_CLIENT_ID=
PLAID_SECRET=
# npm run gen-key
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32 (at least 24 characters)
ADMIN_API_KEY=

# Optional
PLAID_ENV=production
PLAID_PRODUCTS=transactions
# Extra products to pull when the bank supports them: liabilities,investments,identity,recurring
# Each is billed per Item in production, and trial access may only include some.
# Empty = transactions only. Leaving the line out entirely pulls all four.
PLAID_EXTRA_PRODUCTS=
PLAID_COUNTRY_CODES=US
PORT=7600
# 127.0.0.1 = this machine only (put tailscale serve in front). 0.0.0.0 = every network.
HOST=127.0.0.1
DB_PATH=./data/plaid.db
SYNC_INTERVAL_MINUTES=60
# Comma-separated origins of browser frontends
CORS_ORIGINS=
# Public HTTPS URL ending in /webhooks/plaid
PLAID_WEBHOOK_URL=
# Needed for OAuth banks in production
PLAID_REDIRECT_URI=
